// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// USER ROLES
// -----------------------------------------------------

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MemoryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum MemoryFactOrigin {
  EXPLICIT
  INFERRED
  CONFIRMED
  MIGRATED
}

enum MemoryFactSensitivity {
  LOW
  HIGH
}

enum MemoryFactStatus {
  ACTIVE
  SUPERSEDED
  DELETED
}

// -----------------------------------------------------
// USER (identità unica cross-canale)
// -----------------------------------------------------

model User {
  id String @id @default(cuid())

  // Authentication - Clerk integration for web chat
  clerkId String? @unique
  email   String? @unique

  // Guest / anonymous mode
  // Guest users can chat before registering; they should NOT get the full trial.
  isGuest          Boolean   @default(false)
  guestTokenHash   String?   @unique // hash of the HttpOnly session token
  guestAbuseIdHash String? // keyed HMAC of a trusted abuse-control identifier
  guestConvertedAt DateTime? // set when the guest account is merged/converted

  // Role-based access control
  role UserRole @default(USER)

  // Relationships
  profile                     Profile?
  preferences                 Preferences?
  memories                    Memory[]
  memoryRevisions             MemoryRevision[]
  memoryApprovals             MemoryApproval[]
  conversationRecallChunks   ConversationRecallChunk[]
  routines                    Routine[]
  messages                    Message[]
  attachments                 Attachment[]
  chats                       Chat[]
  conversationThreads         ConversationThread[]
  aiTurnTraces                AiTurnTrace[]
  dailyUsage                  DailyUsage[]
  aiUsageReservations         AiUsageReservation[]
  dailyUploadUsage            DailyUploadUsage[]
  uploadReservations          UploadReservation[]
  identities                  ChannelIdentity[]
  consumedLinkTokens          ChannelLinkToken[]           @relation("ChannelLinkTokenConsumedBy")
  subscription                Subscription?
  sessionSummaries            SessionSummary[]
  archivedSessions            ArchivedSession[]
  voiceUsage                  VoiceUsage[]
  voiceGenerationJobs         VoiceGenerationJob[]
  organizationMemberships     OrganizationMembership[]
  ownedOrganizations          Organization[]               @relation("OrganizationOwner")
  createdOrganizations        Organization[]               @relation("OrganizationCreator")
  organizationAuditLogs       OrganizationAuditLog[]       @relation("OrganizationAuditActor")
  modelExperimentParticipants ModelExperimentParticipant[]
  modelExperimentPairs        ModelExperimentPair[]
  modelExperimentAudits       ModelExperimentAudit[]       @relation("ModelExperimentAuditActor")
  createdModelExperiments     ModelExperiment[]            @relation("ModelExperimentCreator")

  billingSyncedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete

  @@index([role])
  @@index([isGuest])
  @@index([guestAbuseIdHash])
  @@index([deletedAt])
  @@index([billingSyncedAt])
}

// -----------------------------------------------------
// ORGANIZATIONS (B2B tenancy via Clerk Organizations)
// -----------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationModelTier {
  TRIAL
  BASIC
  BASIC_PLUS
  PRO
  ENTERPRISE
  ADMIN
}

enum OrganizationBasePlan {
  BASIC
  BASIC_PLUS
  PRO
}

enum OrganizationMemberRole {
  OWNER
  MEMBER
}

enum OrganizationMembershipStatus {
  ACTIVE
  REMOVED
  BLOCKED
}

enum OrganizationAuditActorType {
  ADMIN
  SYSTEM
  WEBHOOK
}

enum OrganizationAuditAction {
  ORGANIZATION_CREATED
  CONTRACT_UPDATED
  OWNER_ASSIGNED
  OWNER_TRANSFERRED
  MEMBERSHIP_SYNCED
  MEMBERSHIP_BLOCKED_SEAT_LIMIT
}

model Organization {
  id String @id @default(cuid())

  clerkOrganizationId String             @unique
  name                String
  slug                String             @unique
  status              OrganizationStatus @default(ACTIVE)

  ownerUserId String?
  ownerUser   User?   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  pendingOwnerEmail String?

  createdByUserId String
  createdByUser   User   @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  contract    OrganizationContract?
  memberships OrganizationMembership[]
  auditLogs   OrganizationAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerUserId])
  @@index([createdByUserId])
}

model OrganizationContract {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  basePlan  OrganizationBasePlan  @default(BASIC)
  seatLimit Int
  planLabel String
  modelTier OrganizationModelTier @default(BASIC)

  maxRequestsPerDay     Int
  maxInputTokensPerDay  Int
  maxOutputTokensPerDay Int
  maxCostPerDay         Float
  maxContextMessages    Int

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([basePlan])
  @@index([modelTier])
}

model OrganizationMembership {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clerkMembershipId String                       @unique
  role              OrganizationMemberRole       @default(MEMBER)
  status            OrganizationMembershipStatus @default(ACTIVE)

  joinedAt DateTime?
  leftAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([role])
}

model OrganizationAuditLog {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation("OrganizationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorType OrganizationAuditActorType
  action    OrganizationAuditAction
  before    Json?
  after     Json?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId])
}

// -----------------------------------------------------
// CHANNEL IDENTITY (una identità per ogni canale: es. WhatsApp=numero telefono)
// -----------------------------------------------------

model ChannelIdentity {
  id String @id @default(cuid())

  channel    Channel @default(WHATSAPP)
  externalId String // e.g.: WhatsApp phone number, Telegram user ID, Instagram PSID

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([channel, externalId])
  @@index([userId])
  @@index([channel])
}

// -----------------------------------------------------
// CHANNEL LINK TOKENS (one-time linking flow)
// -----------------------------------------------------

model ChannelLinkToken {
  id String @id @default(cuid())

  channel   Channel
  tokenHash String  @unique

  // External identity to link (e.g. Telegram user id)
  externalId String
  chatId     String

  expiresAt  DateTime
  consumedAt DateTime?

  consumedByUserId String?
  consumedByUser   User?   @relation("ChannelLinkTokenConsumedBy", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([channel, externalId])
  @@index([expiresAt])
}

// -----------------------------------------------------
// CONNECT COMMAND DELIVERY (retry-safe channel linking)
// -----------------------------------------------------

enum ChannelConnectResponseKind {
  LINK
  ALREADY_LINKED
  UNAVAILABLE
}

enum ChannelConnectDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// A provider message can be delivered more than once. This marker owns the
// one-time link-token creation and the outbound response delivery lifecycle.
model ChannelConnectRequest {
  id String @id @default(cuid())

  channel           Channel
  externalMessageId String
  externalId        String
  chatId            String
  responseKind      ChannelConnectResponseKind

  status                 ChannelConnectDeliveryStatus @default(PENDING)
  claimToken             String?
  deliveryLeaseExpiresAt DateTime?
  deliveryAttempts       Int                          @default(0)
  deliveredAt            DateTime?
  lastDeliveryError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalMessageId])
  @@index([status, deliveryLeaseExpiresAt])
}

enum Channel {
  WEB
  WHATSAPP
  TELEGRAM
  // FUTURE: TELEGRAM, INSTAGRAM, MESSENGER, EMAIL, IOS_APP, ANDROID_APP
}

enum ExternalInboundProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AiUsageReservationStatus {
  RESERVED
  RECONCILED
  RELEASED
  EXPIRED
}

enum UploadReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

// -----------------------------------------------------
// CHAT (conversation sessions)
// -----------------------------------------------------

enum ChatVisibility {
  PRIVATE
  PUBLIC
}

enum ChatIcon {
  TARGET
  TROPHY
  DUMBBELL
  ACTIVITY
  BRAIN
  HEART_PULSE
  TIMER
  CALENDAR_DAYS
  FLAME
  SHIELD
  USERS
  FOOTPRINTS
  REFRESH_CCW
  MESSAGE_SQUARE
}

enum RoutineChatMode {
  REPEAT
  ADAPT
}

model Chat {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String? // Auto-generated or user-provided
  customTitle Boolean        @default(false)
  icon        ChatIcon       @default(MESSAGE_SQUARE)
  visibility  ChatVisibility @default(PRIVATE)

  // Optional context for a chat started from the routine collection. This is
  // an invocation link (many chats may reuse one routine), not ownership of
  // the routine itself.
  routineContextRoutineId String?
  routineContextRoutine   Routine?         @relation("RoutineChatContext", fields: [routineContextRoutineId], references: [id], onDelete: SetNull)
  routineContextMode      RoutineChatMode?

  messages             Message[]
  conversationThread   ConversationThread?
  modelExperimentPairs ModelExperimentPair[]
  sourceRoutines       Routine[]            @relation("RoutineSourceChat")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([visibility])
  @@index([deletedAt])
  @@index([routineContextRoutineId])
}

// -----------------------------------------------------
// MESSAGE (supporta testo, media, template, location, audio, ecc.)
// -----------------------------------------------------

model Message {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chat reference (for multi-chat support)
  chatId String?
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Stable conversation scope. New writes must always populate this, while
  // the nullable relation keeps legacy messages migratable.
  conversationThreadId String?
  conversationThread   ConversationThread? @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)

  channel   Channel          @default(WHATSAPP)
  direction MessageDirection
  role      MessageRole

  // Message content and media
  type  MessageType @default(TEXT)
  parts Json? // AI SDK v5 message parts format

  mediaUrl  String? // Media URL: images, audio, video, documents, stickers
  mediaType String? // MIME type e.g.: image/jpeg, audio/ogg

  externalMessageId        String? // External message ID from WhatsApp/Telegram/Instagram
  clientMessageId          String? // Validated AI SDK UI message ID for idempotent web retries
  clientMessagePayloadHash String? // Stable hash used to reject changed retry payloads without persisting untrusted client data
  metadata                 Json? // Dynamic payload (location, template params, button events, etc.)

  // Exactly one durable assistant response may be generated for an inbound
  // message. Provider-delivery retries reuse this row instead of calling AI.
  sourceInboundMessageId String?             @unique
  sourceInboundMessage   Message?            @relation("InboundAssistantResponse", fields: [sourceInboundMessageId], references: [id], onDelete: SetNull)
  generatedResponse      Message?            @relation("InboundAssistantResponse")
  usageReservation       AiUsageReservation? @relation("AiUsageReservationAssistant")

  externalInboundStatus         ExternalInboundProcessingStatus?
  externalInboundClaimToken     String?
  externalInboundLeaseExpiresAt DateTime?
  externalInboundAttempts       Int?
  externalInboundCompletedAt    DateTime?
  externalInboundLastError      String?

  // -----------------------------------------------------
  // AI TRACKING (for ASSISTANT messages only)
  // -----------------------------------------------------
  model            String? // e.g.: "x-ai/grok-4.1-fast:free", "google/gemini-2.5-flash"
  inputTokens      Int? // Input tokens (prompt)
  outputTokens     Int? // Output tokens generated
  reasoningTokens  Int? // Reasoning tokens (for models that support it)
  toolCalls        Json? // Array of tool calls made [{name, args, result}]
  ragUsed          Boolean? @default(false) // Whether RAG was used for this response
  ragChunksCount   Int? // Number of RAG chunks used
  costUsd          Float? // Cost in USD for this response
  generationTimeMs Int? // Total generation time in ms
  reasoningTimeMs  Int? // Reasoning time in ms (if available)
  feedback         Int? // User feedback: -1 = negative, 0 = neutral, 1 = positive

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relationships
  attachments                  Attachment[]
  metrics                      MessageMetrics?
  voiceGenerationJob           VoiceGenerationJob?
  sourceModelExperimentPairs   ModelExperimentPair[] @relation("ModelExperimentSourceMessage")
  canonicalModelExperimentPair ModelExperimentPair?  @relation("ModelExperimentCanonicalMessage")
  sourceRoutines                Routine[]             @relation("RoutineSourceMessage")
  memoryApprovals               MemoryApproval[]      @relation("MemoryApprovalSource")
  sourcedMemories               Memory[]              @relation("MemoryFactSource")
  memoryRevisions               MemoryRevision[]      @relation("MemoryRevisionSource")
  memoryApprovalPresentations   MemoryApproval[]      @relation("MemoryApprovalPresentationAssistant")
  memoryApprovalPresentationIns MemoryApproval[]      @relation("MemoryApprovalPresentationInbound")

  @@unique([channel, externalMessageId])
  @@unique([userId, channel, clientMessageId])
  @@index([userId, channel, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([chatId, createdAt])
  @@index([chatId, userId, createdAt(sort: Desc)])
  @@index([conversationThreadId, createdAt])
  @@index([externalMessageId])
  @@index([externalInboundStatus, externalInboundLeaseExpiresAt])
  @@index([userId, role, createdAt])
  @@index([model, createdAt])
  @@index([deletedAt])
}

// -----------------------------------------------------
// CONVERSATION THREAD (raw history is never cross-channel)
// -----------------------------------------------------

model ConversationThread {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel          Channel
  externalThreadId String

  // Web chats map one-to-one to a thread. External channels use their stable
  // platform thread identifier and intentionally leave this empty.
  chatId String? @unique
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  messages             Message[]
  summary              ConversationThreadSummary?
  traces               AiTurnTrace[]
  modelExperimentPairs ModelExperimentPair[]
  sourcedMemories       Memory[]                  @relation("MemoryFactSourceThread")
  recallChunks          ConversationRecallChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel, externalThreadId])
  @@index([userId, channel, updatedAt(sort: Desc)])
}

model ConversationRecallChunk {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationThreadId String
  conversationThread   ConversationThread @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)
  channel              Channel
  startMessageId       String
  endMessageId         String
  throughMessageId     String
  content              String             @db.Text
  summary              String?            @db.Text
  sourceCreatedAt      DateTime
  embedding            Unsupported("vector(1536)")?
  indexVersion         Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([conversationThreadId, throughMessageId, indexVersion])
  @@index([userId, conversationThreadId, sourceCreatedAt(sort: Desc)])
  @@index([userId, channel, sourceCreatedAt(sort: Desc)])
}

// -----------------------------------------------------
// PAIRED MODEL COMPARISON EXPERIMENTS
// -----------------------------------------------------

enum ModelExperimentStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  COMPLETED
}

enum ModelExperimentVariantRole {
  CONTROL
  CANDIDATE
}

enum ModelExperimentNoticeState {
  NOT_SHOWN
  SHOWN
}

enum ModelExperimentPairStatus {
  GENERATING
  READY
  RESOLVED
  PARTIAL_FAILED
  FAILED
  EXPIRED
}

enum ModelExperimentVote {
  A
  B
  TIE
  AUTO_CONTROL
  AUTO_SUCCESS
}

enum ModelExperimentResponseStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  PURGED
}

enum CapabilityPlannerMode {
  legacy
  agentic
}

model ModelExperiment {
  id String @id @default(cuid())

  key            String                @unique
  name           String
  status         ModelExperimentStatus @default(DRAFT)
  posthogFlagKey String
  targetCountry  String                @default("IT") @db.VarChar(2)
  cooldownHours  Int                   @default(24)
  perUserCap     Int                   @default(5)

  createdByAdminId String
  createdByAdmin   User   @relation("ModelExperimentCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  readyAt     DateTime?
  activatedAt DateTime?
  pausedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants     ModelExperimentVariant[]
  participants ModelExperimentParticipant[]
  pairs        ModelExperimentPair[]
  audits       ModelExperimentAudit[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ModelExperimentVariant {
  id String @id @default(cuid())

  experimentId String
  experiment   ModelExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  role             ModelExperimentVariantRole
  modelId          String
  provider         String                     @default("openrouter")
  generationConfig Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses       ModelExperimentResponse[]
  pairSlotA       ModelExperimentPair[]     @relation("ModelExperimentSlotA")
  pairSlotB       ModelExperimentPair[]     @relation("ModelExperimentSlotB")
  selectedInPairs ModelExperimentPair[]     @relation("ModelExperimentSelectedVariant")

  @@unique([experimentId, role])
  @@index([modelId])
}

model ModelExperimentParticipant {
  id String @id @default(cuid())

  experimentId String
  experiment   ModelExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  noticeState          ModelExperimentNoticeState @default(NOT_SHOWN)
  attempts             Int                        @default(0)
  completedComparisons Int                        @default(0)
  nextEligibleAt       DateTime?
  enrolledAt           DateTime                   @default(now())
  lastExposedAt        DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  pairs ModelExperimentPair[]

  @@unique([experimentId, userId])
  @@index([userId])
  @@index([experimentId, nextEligibleAt])
}

model ModelExperimentPair {
  id String @id @default(cuid())

  experimentId         String
  experiment           ModelExperiment            @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  participantId        String
  participant          ModelExperimentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId               String
  chat                 Chat                       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  conversationThreadId String
  conversationThread   ConversationThread         @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)
  sourceMessageId      String                     @unique
  sourceMessage        Message                    @relation("ModelExperimentSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  slotAVariantId String
  slotAVariant   ModelExperimentVariant @relation("ModelExperimentSlotA", fields: [slotAVariantId], references: [id], onDelete: Restrict)
  slotBVariantId String
  slotBVariant   ModelExperimentVariant @relation("ModelExperimentSlotB", fields: [slotBVariantId], references: [id], onDelete: Restrict)

  status                ModelExperimentPairStatus @default(GENERATING)
  vote                  ModelExperimentVote?
  selectedVariantId     String?
  selectedVariant       ModelExperimentVariant?   @relation("ModelExperimentSelectedVariant", fields: [selectedVariantId], references: [id], onDelete: Restrict)
  canonicalMessageId    String?                   @unique
  canonicalMessage      Message?                  @relation("ModelExperimentCanonicalMessage", fields: [canonicalMessageId], references: [id], onDelete: SetNull)
  countryCode           String                    @db.VarChar(2)
  promptMode            String?
  capabilityPlannerMode CapabilityPlannerMode     @default(legacy)
  turnDecision          Json?
  exposedAt          DateTime?
  readyAt            DateTime?
  resolvedAt         DateTime?
  expiresAt          DateTime
  contentPurgeAt     DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  responses ModelExperimentResponse[]

  @@index([experimentId, status])
  @@index([participantId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([contentPurgeAt])
}

model ModelExperimentResponse {
  id String @id @default(cuid())

  pairId    String
  pair      ModelExperimentPair    @relation(fields: [pairId], references: [id], onDelete: Cascade)
  variantId String
  variant   ModelExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  status             ModelExperimentResponseStatus @default(PENDING)
  parts              Json?
  text               String?                       @db.Text
  provider           String
  modelId            String
  generationConfig   Json
  traceId            String                        @unique
  errorCode          String?
  inputTokens        Int?
  outputTokens       Int?
  reasoningTokens    Int?
  costUsd            Float?
  timeToFirstTokenMs Int?
  generationTimeMs   Int?
  firstTokenAt       DateTime?
  completedAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([pairId, variantId])
  @@index([variantId, status])
  @@index([pairId, status])
}

model ModelExperimentAudit {
  id String @id @default(cuid())

  experimentId String
  experiment   ModelExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  actorUserId  String
  actor        User            @relation("ModelExperimentAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  action       String
  before       Json?
  after        Json?
  createdAt    DateTime        @default(now())

  @@index([experimentId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model ConversationThreadSummary {
  id String @id @default(cuid())

  conversationThreadId String             @unique
  conversationThread   ConversationThread @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)

  summary                 String    @db.Text
  throughMessageId        String?
  throughMessageCreatedAt DateTime?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

enum AiTurnTraceStatus {
  PENDING
  COMPLETE
  FAILED
}

model AiTurnTrace {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationThreadId String
  conversationThread   ConversationThread @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)

  userMessageId      String?
  assistantMessageId String?
  status             AiTurnTraceStatus @default(PENDING)
  metadata           Json

  payloadCiphertext    Bytes?
  payloadIv            Bytes?
  payloadTag           Bytes?
  keyVersion           Int    @default(1)
  contentCaptureStatus String @default("pending")

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessAudits AiTraceAccessAudit[]

  @@index([conversationThreadId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([userMessageId])
}

model AiTraceAccessAudit {
  id String @id @default(cuid())

  traceId String
  trace   AiTurnTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  actorUserId String
  action      String
  createdAt   DateTime @default(now())

  @@index([traceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model MessageMetrics {
  id String @id @default(cuid())

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  model    String?
  provider String?

  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  reasoningTokens Int?

  costUsd          Float?
  generationTimeMs Int?
  reasoningTimeMs  Int?

  toolCallCount   Int?
  toolResultChars Int?
  toolTiming      Json?

  ragUsed        Boolean?
  ragChunksCount Int?

  providerMetadata Json?
  executionRoute  Json?
  serverTrace     Json?
  clientTrace     Json?
  developerDiagnostics Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([model, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
}

enum MessageDirection {
  INBOUND // utente → Anthon
  OUTBOUND // Anthon → utente
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  TEMPLATE
  LOCATION
  CONTACT
  UNKNOWN
}

// -----------------------------------------------------
// COACHING ROUTINES
// -----------------------------------------------------

enum RoutineStatus {
  ACTIVE
  ARCHIVED
}

enum RoutineAttemptOutcome {
  HELPFUL
  PARTIALLY_HELPFUL
  NOT_HELPFUL
}

model Routine {
  id                       String        @id @default(cuid())
  userId                   String
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceChatId             String?
  sourceChat               Chat?         @relation("RoutineSourceChat", fields: [sourceChatId], references: [id], onDelete: SetNull)
  sourceAssistantMessageId String?
  sourceAssistantMessage   Message?      @relation("RoutineSourceMessage", fields: [sourceAssistantMessageId], references: [id], onDelete: SetNull)
  derivedFromRoutineId     String?
  derivedFromRoutine       Routine?      @relation("RoutineAdaptations", fields: [derivedFromRoutineId], references: [id], onDelete: SetNull)
  adaptations              Routine[]     @relation("RoutineAdaptations")
  routineChatContexts      Chat[]        @relation("RoutineChatContext")
  title                    String
  trigger                  String
  durationLabel            String?
  formatVersion            Int           @default(1)
  steps                    Json
  completionCue            String
  status                   RoutineStatus @default(ACTIVE)
  archivedAt               DateTime?
  attempts                 RoutineAttempt[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@unique([userId, sourceAssistantMessageId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([sourceChatId])
  @@index([derivedFromRoutineId])
}

model RoutineAttempt {
  id                String                 @id @default(cuid())
  routineId         String
  routine           Routine                @relation(fields: [routineId], references: [id], onDelete: Cascade)
  clientActionId    String
  attemptedAt       DateTime               @default(now())
  outcome           RoutineAttemptOutcome?
  outcomeNote       String?                @db.Text
  outcomeRecordedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([routineId, clientActionId])
  @@index([routineId, attemptedAt(sort: Desc)])
}

// -----------------------------------------------------
// PROFILE (informazioni di coaching dell’utente)
// -----------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // User coaching information
  name       String?
  sport      String?
  goal       String?
  experience String?
  birthday   DateTime?
  notes      String?   @db.Text // Use TEXT for potentially long notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------
// PREFERENCES (tono, stile, lingua, notifiche)
// -----------------------------------------------------

model Preferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tone         String? // e.g.: "calm", "energetic", "professional"
  mode         String? // e.g.: "coaching", "friendly", "direct"
  language     String?  @default("IT") // IT, EN, etc.
  push         Boolean? @default(true) // Push notifications enabled by default
  voiceEnabled Boolean? @default(true) // Voice messages enabled (false = Quiet Mode)
  showTechnicalMetrics Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------
// MEMORY (memoria persistente condivisa tra tutti i canali)
// -----------------------------------------------------

model Memory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key      String
  value    Json
  category String @default("other")

  origin          MemoryFactOrigin      @default(MIGRATED)
  sensitivity     MemoryFactSensitivity @default(LOW)
  confidence      Float                 @default(1)
  status          MemoryFactStatus      @default(ACTIVE)
  sourceMessageId String?
  sourceMessage   Message?              @relation("MemoryFactSource", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceThreadId  String?
  sourceThread    ConversationThread?   @relation("MemoryFactSourceThread", fields: [sourceThreadId], references: [id], onDelete: SetNull)
  observedAt      DateTime              @default(now())
  lastConfirmedAt DateTime?
  expiresAt       DateTime?
  revisions       MemoryRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, key])
  @@index([userId, category])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, expiresAt])
  @@index([sourceMessageId])
  @@index([sourceThreadId])
}

model MemoryRevision {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  memoryId String
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  sourceMessageId String?
  sourceMessage   Message? @relation("MemoryRevisionSource", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  previousValue Json?
  nextValue     Json?
  origin        MemoryFactOrigin
  reason        String
  dedupeKey     String           @unique
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([memoryId, createdAt(sort: Desc)])
  @@index([sourceMessageId])
}

model MemoryApproval {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceInboundMessageId String
  sourceInboundMessage   Message @relation("MemoryApprovalSource", fields: [sourceInboundMessageId], references: [id], onDelete: Cascade)

  presentationInboundMessageId String?
  presentationInboundMessage   Message? @relation("MemoryApprovalPresentationInbound", fields: [presentationInboundMessageId], references: [id], onDelete: SetNull)
  presentationAssistantMessageId String?
  presentationAssistantMessage   Message? @relation("MemoryApprovalPresentationAssistant", fields: [presentationAssistantMessageId], references: [id], onDelete: SetNull)

  key        String
  value      Json
  category   String
  confidence Float
  status     MemoryApprovalStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  resolvedAt DateTime?

  @@index([userId, status, createdAt])
  @@index([sourceInboundMessageId])
  @@index([presentationInboundMessageId])
  @@index([presentationAssistantMessageId])
}

// -----------------------------------------------------
// SESSION SUMMARY (persistent cache for session summaries)
// -----------------------------------------------------

model SessionSummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String @unique // Composite of start/end timestamps
  summary   String @db.Text

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// -----------------------------------------------------
// ARCHIVED SESSION (long-term storage of summarized sessions)
// -----------------------------------------------------

model ArchivedSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  summary   String   @db.Text

  // Metrics preserved from the session
  messageCount Int

  createdAt DateTime @default(now())

  @@index([userId, startDate])
}

// -----------------------------------------------------
// RAG DOCUMENTS (Metodo Sincro, PDF, ecc.)
// -----------------------------------------------------

model RagDocument {
  id     String  @id @default(cuid())
  title  String
  url    String?
  source String? // Source identifier (e.g., "training_manual", "knowledge_base")

  chunks RagChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([source])
}

// -----------------------------------------------------
// RAG CHUNKS (embedding pgvector)
// -----------------------------------------------------

model RagChunk {
  id         String      @id @default(cuid())
  documentId String
  document   RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content   String                       @db.Text
  embedding Unsupported("vector(1536)")?
  index     Int // Chunk sequence number within document

  createdAt DateTime @default(now())
  // Note: Vector index is created via raw SQL migration (HNSW index)
  // See: prisma/migrations/20251202120000_fix_vector_index/migration.sql

  @@index([documentId])
  @@index([documentId, index])
}

// -----------------------------------------------------
// MODEL PRICING (prezzi per calcolo costi AI)
// NOTE: Removed - replaced by TokenLens which fetches pricing from OpenRouter API
// -----------------------------------------------------

// -----------------------------------------------------
// ATTACHMENT (file uploads)
// -----------------------------------------------------

model Attachment {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId          String?
  message            Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  voiceGenerationJob VoiceGenerationJob? @relation("VoiceGenerationAttachment")

  name        String // Original filename
  contentType String // MIME type
  size        Int // Size in bytes
  blobUrl     String // Vercel Blob URL

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([messageId])
}

// -----------------------------------------------------
// DAILY USAGE (rate limiting & analytics)
// -----------------------------------------------------

model DailyUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date // UTC date
  requestCount    Int      @default(0)
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  reasoningTokens Int      @default(0)
  totalCostUsd    Float    @default(0)
  voiceCostUsd    Float    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model AiUsageReservation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime                 @db.Date
  requestKey String
  claimToken String
  status     AiUsageReservationStatus @default(RESERVED)

  reservedRequests     Int   @default(1)
  reservedInputTokens  Int   @default(0)
  reservedOutputTokens Int   @default(0)
  reservedCostUsd      Float @default(0)

  actualInputTokens     Int?
  actualOutputTokens    Int?
  actualReasoningTokens Int?
  actualCostUsd         Float?

  recoveryText      String?
  recoveryMetrics   Json?
  recoveryExpiresAt DateTime?

  assistantMessageId String?
  assistantMessage   Message?  @relation("AiUsageReservationAssistant", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  reconciledAt       DateTime?
  releasedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, requestKey])
  @@unique([assistantMessageId])
  @@index([userId, date, status, expiresAt])
}

model DailyUploadUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime @db.Date
  uploadCount   Int      @default(0)
  uploadedBytes BigInt   @default(0)
  reservedCount Int      @default(0)
  reservedBytes BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

model UploadReservation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime                @db.Date
  byteCount BigInt
  status    UploadReservationStatus @default(RESERVED)
  expiresAt DateTime

  committedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date, status, expiresAt])
}

model GuestAbuseBucket {
  id String @id @default(cuid())

  fingerprintHash String
  windowStart     DateTime @db.Date
  createdSessions Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([fingerprintHash, windowStart])
  @@index([windowStart])
}

// -----------------------------------------------------
// SUBSCRIPTION (tracking trial/conversioni)
// -----------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status              SubscriptionStatus @default(TRIAL)
  clerkSubscriptionId String?            @unique // Clerk Billing subscription ID

  // Trial tracking
  trialStartedAt DateTime? @default(now()) // When trial started
  trialEndsAt    DateTime? // When trial expires

  // Conversion tracking
  convertedAt DateTime? // When converted to paid
  canceledAt  DateTime? // When subscription was canceled

  // Plan information
  planId   String? // Plan ID (from Clerk)
  planName String? // Plan name for reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([trialEndsAt])
  @@index([userId, status])
  @@index([status, trialEndsAt])
}

// -----------------------------------------------------
// VOICE USAGE (tracking Eleven Labs voice generation)
// -----------------------------------------------------

model VoiceUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedAt          DateTime            @default(now())
  characterCount       Int // Characters sent to Eleven Labs
  costUsd              Float? // Estimated cost in USD
  channel              Channel             @default(TELEGRAM) // Which channel triggered the voice
  voiceGenerationJobId String?             @unique
  voiceGenerationJob   VoiceGenerationJob? @relation(fields: [voiceGenerationJobId], references: [id], onDelete: SetNull)

  @@index([userId, generatedAt(sort: Desc)])
  @@index([generatedAt])
}

// -----------------------------------------------------
// WEB VOICE GENERATION (durable, retry-safe TTS lifecycle)
// -----------------------------------------------------

enum VoiceGenerationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  CANCELLED
}

// One job owns one web assistant message. The claim token and lease make
// QStash's at-least-once deliveries safe: only the worker that currently owns
// the lease can attach media or account for voice usage.
model VoiceGenerationJob {
  id String @id @default(cuid())

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         VoiceGenerationStatus @default(PENDING)
  attempts       Int                   @default(0)
  claimToken     String?
  leaseExpiresAt DateTime?
  expiresAt      DateTime

  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  // Once upload succeeds, retries finalize this same private object instead
  // of paying for another TTS request.
  blobUrl        String?
  audioSize      Int?
  characterCount Int?
  costUsd        Float?
  attachmentId   String?     @unique
  attachment     Attachment? @relation("VoiceGenerationAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  errorCode        String?
  processingTimeMs Int?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  voiceUsage VoiceUsage?

  @@index([status, leaseExpiresAt])
  @@index([status, expiresAt])
  @@index([userId, createdAt(sort: Desc)])
}
