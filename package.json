{
  "name": "anthon-2.0",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "vercel:build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "bun run lint && bun run typecheck && bun run test:coverage:unit",
    "format": "biome format --write",
    "test": "vitest run",
    "test:e2e": "bun scripts/run-ephemeral-e2e-tests.ts",
    "test:e2e:instant": "EXPOSE_TESTING_API=1 bun run build && INSTANT_NAV_RIG=1 bun scripts/run-ephemeral-e2e-tests.ts e2e/instant-chat.spec.ts",
    "test:coverage": "bun run test:coverage:unit && bun run test:coverage:integration",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:integration": "bun scripts/run-ephemeral-integration-tests.ts --coverage",
    "test:integration": "bun scripts/run-ephemeral-integration-tests.ts",
    "test:performance": "RUN_LIVE_PERFORMANCE=true vitest run -c vitest.performance.config.ts",
    "test:tinyfish": "RUN_TINYFISH_LIVE_TESTS=true vitest run src/lib/ai/tools/tinyfish.live.test.ts",
    "test:all": "bun run test:coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "postinstall": "prisma generate",
    "knip": "knip",
    "eval:chat-metadata": "bun run scripts/evaluate-chat-metadata-models.ts",
    "benchmark:conversation": "bun run scripts/run-conversation-benchmark.ts",
    "benchmark:memory-recall": "bun run scripts/run-memory-recall-benchmark.ts",
    "backfill:conversation-recall": "bun run scripts/backfill-conversation-recall.ts",
    "analyze": "next experimental-analyze"
  },
  "prisma": {
    "seed": "bunx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/devtools": "1.0.9",
    "@ai-sdk/provider": "4.0.4",
    "@ai-sdk/react": "4.0.48",
    "@base-ui/react": "1.7.0",
    "@clerk/localizations": "4.13.10",
    "@clerk/nextjs": "7",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@posthog/nextjs-config": "^1.9.68",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/qstash": "^2.8.4",
    "@vercel/blob": "^2.3.0",
    "@vercel/functions": "^3.3.4",
    "ai": "7.0.45",
    "class-variance-authority": "^0.7.1",
    "cnfast": "0.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "13.1.0",
    "lucide-react": "1.31.0",
    "mammoth": "^1.12.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "1.1.1",
    "pg": "^8.16.3",
    "posthog-js": "^1.409.5",
    "posthog-node": "^5.18.0",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "svix": "^1.99.1",
    "tokenlens": "^1.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@next/playwright": "16.3.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "jsdom": "^29.1.1",
    "knip": "5.88.1",
    "postcss": "^8.5.25",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "rollup": "4.62.3",
    "smol-toml": "1.7.1",
    "underscore": "1.13.8",
    "vite": "8.2.0"
  }
}
